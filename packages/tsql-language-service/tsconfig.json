{
    "extends": "../../extensions/tsconfig.base.json",
    "compilerOptions": {
        "rootDir": "src",
        "outDir": "dist",
        "module": "CommonJS",
        "moduleResolution": "Node",
        "declaration": true,
        "declarationMap": true,
        "noEmit": false,
        "strict": false,
        "types": ["node"]
    },
    "include": ["src/**/*"],
    "exclude": ["dist", "node_modules", "test"]
}
