@top Script { Item* }

Item {
  Whitespace |
  LineComment |
  BlockComment |
  Word |
  Number |
  String |
  Punctuation |
  Other
}

@tokens {
  @precedence { BlockComment, LineComment, String, Word, Number, Punctuation, Other }
  Whitespace { $[\u0009\u000a\u000d\u0020]+ }
  LineComment { "--" ![\n\r]* }
  BlockComment { "/*" (![*] | "*" ![/])* "*/" }
  Word { $[A-Za-z_#@] $[A-Za-z0-9_#$@]* }
  Number { $[0-9]+ ("." $[0-9]+)? }
  String { "'" ("''" | !['])* "'" }
  Punctuation { $[;,.()=+*/<>-] }
  Other { ![A-Za-z0-9_#@'\u0009\u000a\u000d\u0020] }
}
