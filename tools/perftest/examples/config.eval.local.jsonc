// Full-evaluation gate run (B7 close-out re-verification + multi-rep QS baseline).
// Covers the standing gates: query-10k-results, debug-console-smoke,
// querystudio-open, querystudio-query-10k — 3 official reps each (+1 warmup)
// so querystudio-query-10k starts accruing multi-rep baseline history
// (PROGRESS Entry 9 residual).
// Run from the perftest repo root:
//   node packages/perftest-cli/dist/cli.js run --config examples/config.eval.local.jsonc
{
    "schemaVersion": 2,
    "runId": "auto",
    "passType": "measurement",
    "repetitions": 3,
    "warmupRepetitions": 1,
    "scenarios": [
        "debug-console-smoke",
        "querystudio-open",
        "querystudio-open-autorun",
        "querystudio-query-10k",
        "querystudio-query-wide",
        "querystudio-query-blob",
        "objectexplorerv2-browse",
        "objectexplorerv2-security-expand",
        "metadatacache-warm-acquire",
        "query-10k-results",
    ],
    "vscode": {
        "version": "stable",
        "quality": "stable",
        "launchMode": "directSpawn",
        "profileMode": "scenarioDefault",
        "workspaceRoot": "../workspaces/perf",
        "extensions": [
            {
                "id": "ms-mssql.mssql",
                "source": "developmentPath",
                "path": "../../../extensions/mssql",
            },
            {
                "id": "perftest.mssql-perf-driver",
                "source": "developmentPath",
                "path": "../extensions/mssql-perf-driver",
            },
        ],
        "extraArgs": [],
        "env": {},
    },
    "sql": {
        "provider": "external",
        "connectionStringEnv": "STS2_SQLSERVER_CONNSTRING",
        "snapshot": "seed-v2",
        "cacheMode": "warm",
        "connectionProfile": "default",
    },
    "environment": { "requireIdle": false },
    "diagnostics": { "markers": true, "processSampler": false, "otel": "off" },
    "store": { "type": "sqlite", "path": "../perf.db" },
    "regression": { "baseline": "none", "failOnRegression": false },
    "output": { "dir": "../perf-runs", "keepArtifacts": "always" },
}
