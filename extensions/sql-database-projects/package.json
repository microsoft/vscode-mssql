{
    "name": "sql-database-projects-vscode",
    "displayName": "SQL Database Projects",
    "description": "Enables users to develop and publish database schemas for MSSQL Databases",
    "version": "1.9.1",
    "publisher": "ms-mssql",
    "preview": false,
    "homepage": "https://github.com/Microsoft/vscode-mssql/blob/main/extensions/sql-database-projects/README.md",
    "engines": {
        "vscode": "^1.98.0"
    },
    "license": "SEE LICENSE IN LICENSE.txt",
    "icon": "images/sqlDatabaseProjects.png",
    "activationEvents": [],
    "main": "./dist/extension.js",
    "repository": {
        "type": "git",
        "url": "https://github.com/Microsoft/vscode-mssql.git"
    },
    "bugs": {
        "url": "https://github.com/Microsoft/vscode-mssql/issues"
    },
    "extensionDependencies": [
        "ms-mssql.mssql",
        "ms-mssql.data-workspace-vscode"
    ],
    "scripts": {
        "build:extension": "tsc -p tsconfig.extension.json",
        "build:extension-bundle": "node esbuild.mjs",
        "build:runtime-localization": "node ../../scripts/localization-generate.js sql-database-projects .",
        "build:prepare": "npm run build:runtime-localization",
        "build": "node scripts/build.js",
        "watch:extension": "tsc -watch -p tsconfig.extension.json  --preserveWatchOutput",
        "watch:extension-bundle": "node esbuild.mjs --watch",
        "watch": "npm run build:prepare && npm run build:extension && run-p -l watch:extension watch:extension-bundle",
        "lint": "eslint ./src",
        "package": "npm run build -- --prod && vsce package --no-dependencies"
    },
    "capabilities": {
        "virtualWorkspaces": false,
        "untrustedWorkspaces": {
            "supported": true
        }
    },
    "contributes": {},
    "dependencies": {},
    "devDependencies": {
        "@types/node": "^22.13.14",
        "@types/vscode": "1.98.0",
        "@vscode/vsce": "^4.0.0",
        "esbuild": "^0.28.1",
        "npm-run-all": "^4.1.5",
        "typescript": "^5.8.3"
    },
    "__metadata": {}
}
