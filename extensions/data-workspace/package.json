{
    "name": "data-workspace-vscode",
    "displayName": "Data Workspace",
    "description": "Additional common functionality for database projects",
    "version": "0.6.4",
    "publisher": "ms-mssql",
    "preview": true,
    "license": "SEE LICENSE IN LICENSE.txt",
    "icon": "images/extension.png",
    "homepage": "https://github.com/microsoft/vscode-mssql/blob/main/extensions/data-workspace/README.md",
    "engines": {
        "vscode": "^1.98.0"
    },
    "activationEvents": [],
    "main": "./dist/main.js",
    "l10n": "./l10n",
    "repository": {
        "type": "git",
        "url": "https://github.com/microsoft/vscode-mssql.git"
    },
    "bugs": {
        "url": "https://github.com/microsoft/vscode-mssql/issues"
    },
    "extensionDependencies": [
        "ms-mssql.mssql"
    ],
    "scripts": {
        "build:runtime-localization": "node ../../scripts/localization-generate.js data-workspace .",
        "build:extension": "tsc -p tsconfig.json",
        "build:extension-bundle": "node esbuild.mjs",
        "build:prepare": "npm run build:runtime-localization",
        "build": "npm run build:prepare && npm run build:extension && npm run build:extension-bundle",
        "build:prod": "npm run build:prepare && npm run build:extension && npm run build:extension-bundle -- --prod",
        "compile": "npm run build",
        "watch:extension": "tsc -watch -p tsconfig.json --preserveWatchOutput",
        "watch:extension-bundle": "node esbuild.mjs --watch",
        "watch": "npm run build:prepare && run-p -l watch:extension watch:extension-bundle",
        "lint": "eslint ./src ./test",
        "localization:extract": "node ../../scripts/localization-extract.js data-workspace",
        "localization:generate": "node ../../scripts/localization-generate.js data-workspace .",
        "localization": "npm run localization:extract",
        "package": "npm run build:prod && vsce package --no-dependencies"
    },
    "capabilities": {
        "virtualWorkspaces": false,
        "untrustedWorkspaces": {
            "supported": true
        }
    },
    "dependencies": {},
    "devDependencies": {
        "@types/node": "^22.13.14",
        "@types/vscode": "1.98.0",
        "@vscode/l10n-dev": "^0.0.35",
        "@vscode/vsce": "^3.9.1",
        "esbuild": "^0.28.1",
        "npm-run-all": "^4.1.5",
        "should": "^13.2.3",
        "ts-node": "^10.9.2",
        "typescript": "^5.8.3"
    }
}
