{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run All Extensions",
            "type": "extensionHost",
            "request": "launch",
            "args": [
                "--extensionDevelopmentPath=${workspaceFolder}/extensions/mssql",
                "--extensionDevelopmentPath=${workspaceFolder}/extensions/sql-database-projects",
                "--extensionDevelopmentPath=${workspaceFolder}/extensions/data-workspace"
            ],
            "outFiles": [
                "${workspaceFolder}/extensions/mssql/out/**/*.js",
                "${workspaceFolder}/extensions/sql-database-projects/out/**/*.js",
                "${workspaceFolder}/extensions/data-workspace/out/**/*.js"
            ],
            "sourceMaps": true,
            "resolveSourceMapLocations": [
                "${workspaceFolder}/extensions/mssql/dist/**",
                "${workspaceFolder}/extensions/sql-database-projects/out/**",
                "${workspaceFolder}/extensions/data-workspace/out/**"
            ],
            "debugWebviews": true,
            "rendererDebugOptions": {
                "sourceMaps": true,
                "webRoot": "${workspaceFolder}/extensions/mssql"
            },
            "env": {
                // The App Insights key is added during official builds.
                // If you want to examine MSSQL telemetry being emitted during development:
                //  1. Uncomment the following line and set it to the value found in the internal docs.
                //  2. Run the "Developer: Show Telemetry" command in VS Code
                //  3. Check the "Telemetry" output pane.
                // If not set, no telemetry will be emitted or printed to the output pane.
                //"APP_INSIGHTS_KEY": "<App Insights Key>",
                // Uncomment this to use a specified version of STS, see
                // https://github.com/microsoft/vscode-mssql/blob/main/DEVELOPMENT.md#using-mssql_sqltoolsservice-environment-variable
                // for more details
                // "MSSQL_SQLTOOLSSERVICE": "<Path to STS>"
                // Uncomment this to use a local SQL Tools MCP publish folder.
                // Requires mssql.copilot.enableSqlToolsMcp to be enabled in the launched Extension Host.
                // The folder can contain either SQLtoolsMCPserver or SQLtoolsMCPserver.dll.
                // "MSSQL_SQLTOOLS_MCP": "<Path to SQL Tools MCP publish folder>"
            }
        }
    ]
}
